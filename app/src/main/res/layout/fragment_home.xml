                    android:contentDescription="Image of Safdarjung Tomb" />

                <!-- Like and QnA icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/like3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_thumb_up_24"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Like Icon" />

                    <ImageView
                        android:id="@+id/qna3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_question_answer_24"
                        android:contentDescription="QnA Icon" />

                    <!-- Join Community Button -->
                    <Button
                        android:backgroundTint="#7C536DFE"

                        android:id="@+id/joinbutton3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginStart="100dp"
                        android:text="Join Community" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F0F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#C4C7C7"
            android:elevation="4dp"
            android:radius="10dp"
            app:cardCornerRadius="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Profile Icon -->
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_person_24"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Person Icon" />

                    <!-- TextView for Title and Location -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="8dp">

                        <TextView
                            android:id="@+id/textTitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safdarjung Tomb"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLocation1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(New Delhi)"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Image -->
                <ImageView
                    android:id="@+id/image1"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_13"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Image of Safdarjung Tomb" />

                <!-- Like and QnA icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/like1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_thumb_up_24"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Like Icon" />

                    <ImageView
                        android:id="@+id/qna1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_question_answer_24"
                        android:contentDescription="QnA Icon" />

                    <!-- Join Community Button -->
                    <Button
                        android:backgroundTint="#7C536DFE"

                        android:id="@+id/joinbutton1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginStart="100dp"
                        android:text="Join Community" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="40dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#C4C7C7"
            android:elevation="4dp"
            android:radius="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Profile Icon -->
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_person_24"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Person Icon" />

                    <!-- TextView for Title and Location -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="8dp">

                        <TextView
                            android:id="@+id/textTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safdarjung Tomb"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLocation2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(New Delhi)"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Image -->
                <ImageView
                    android:id="@+id/image2"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_13"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Image of Safdarjung Tomb" />

                <!-- Like and QnA icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/like2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_thumb_up_24"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Like Icon" />

                    <ImageView
                        android:id="@+id/qna2"
                        android:layout_width="24dp"

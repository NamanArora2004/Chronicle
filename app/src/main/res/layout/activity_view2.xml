<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ViewActivity2">

    <!-- ImageView for the blog image -->
    <ImageView
        android:id="@+id/imageBlog"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="fitXY"
        android:layout_alignParentTop="true"/>

    <!-- ScrollView to contain the CardView -->
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imageBlog"
        android:fillViewport="true">

        <!-- CardView containing blog details -->
        <androidx.cardview.widget.CardView
            app:cardCornerRadius="25dp"
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Blog title -->
                <TextView
                    android:id="@+id/textview"
                    android:layout_marginLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blog Title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp"/>

                <!-- Author name (above the button) -->
                <TextView
                    android:id="@+id/textview2"
                    android:layout_marginLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Author Name"
                    android:textSize="16sp"
                    android:layout_below="@id/textview"
                    android:layout_alignParentStart="true"
                    android:layout_marginRight="16dp"
                    android:textColor="@android:color/black"/>

                <!-- Follow button (below the author name) -->
                <Button

                    android:id="@+id/followButton"
                    android:layout_below="@id/textview2"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="Follow"
                    android:backgroundTint="@color/main_color"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <!-- Blog content -->
                <TextView
                    android:id="@+id/textview3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blog content goes here..."
                    android:layout_below="@id/followButton"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    android:textColor="@android:color/black"/>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>

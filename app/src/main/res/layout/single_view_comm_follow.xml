<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="350dp"
    android:padding="15dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/material_dynamic_primary100">

    <ImageView
        android:id="@+id/imagemmunity"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/baseline_add_24"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="15dp"
        android:layout_toRightOf="@id/imagemmunity"
        android:gravity="start"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="35dp"
        android:layout_toRightOf="@id/imagemmunity"
        android:textSize="10dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/follow"
        android:layout_width="95dp"
        android:layout_height="30dp"
        android:layout_marginTop="70dp"
        android:layout_marginStart="10dp"
        android:layout_toRightOf="@id/imagemmunity"
        android:background="@drawable/button"
        android:text="Follow" />


    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@color/material_dynamic_neutral70"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="120dp"
        app:cardCornerRadius="20dp">
        <TextView
            android:id="@+id/tv3"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textSize="15dp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:padding="10dp" />

        <ImageView
            android:id="@+id/image_shop"
            android:scaleType="fitXY"
            android:layout_width="350dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:src="@drawable/baseline_add_24" />

        <ImageView
            android:id="@+id/like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="170dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/baseline_thumb_up_24" />

        <ImageView
            android:id="@+id/qna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="170dp"
            android:layout_marginStart="70dp"
            android:src="@drawable/baseline_question_answer_24" />



    </androidx.cardview.widget.CardView>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Blog_Post">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title TextView -->

        <!-- ImageView for Blog Image -->
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="0dp"
            android:background="@color/teal_700">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="60dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Upload your Blog"
            android:textSize="25dp" />
        </androidx.appcompat.widget.Toolbar>

        <ImageView

            android:id="@+id/imageBlog"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_marginLeft="100dp"
            android:layout_marginTop="80dp"
            android:src="@drawable/img_11" />

        <!-- Add Title TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="250dp"
            android:layout_marginLeft="20dp"
            android:textSize="20dp"
            android:text="Add Blog Title" />

        <!-- EditText for Blog Title -->
        <EditText
            android:id="@+id/blogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="280dp"
            android:hint="Enter blog title"
            android:textSize="15dp" />

        <!-- Add Content TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="360dp"
            android:layout_marginLeft="20dp"
            android:textSize="20dp"
            android:text="Add your content" />

        <!-- EditText for Blog Content -->

        <!-- Author Name TextView -->

        <EditText

            android:id="@+id/textview2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="390dp"
            android:layout_marginRight="20dp"
            android:backgroundTint="#8A7C7C"
            android:gravity="top"
            android:hint="Write your blog content here"
            android:minHeight="200dp"
            android:textSize="15dp" />

        <TextView
            android:backgroundTint="#8A7C7C"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="620dp"
            android:text="Author Name" />

        <!-- EditText for Author Name -->
        <EditText
            android:id="@+id/authorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Author Name"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="640dp" />

        <!-- Upload Button -->
        <Button
            android:backgroundTint="@android:color/system_neutral2_400"

            android:id="@+id/btn1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="250dp"
            android:layout_marginTop="700dp"
            android:text="Upload" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar_blog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="760dp"
            android:layout_marginLeft="150dp"
            android:visibility="gone" />

        <!-- Progress Text View -->
        <TextView
            android:id="@+id/tviewProgressBlog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uploading..."
            android:layout_marginTop="780dp"
            android:layout_marginLeft="150dp"
            android:visibility="gone" />
    </RelativeLayout>
</ScrollView>
